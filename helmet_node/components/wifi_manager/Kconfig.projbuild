menu "Smart Helmet Phase 7 Communication"

    config SMART_HELMET_DEVICE_ID
        string "Device ID for cloud reports"
        default "Helmet_001"

    config SMART_HELMET_WIFI_ENABLE
        bool "Enable Wi-Fi station manager"
        default n

    config SMART_HELMET_WIFI_SSID
        string "Wi-Fi SSID"
        default ""
        depends on SMART_HELMET_WIFI_ENABLE

    config SMART_HELMET_WIFI_PASSWORD
        string "Wi-Fi password"
        default ""
        depends on SMART_HELMET_WIFI_ENABLE

    config SMART_HELMET_WIFI_MAX_RETRY
        int "Wi-Fi reconnect retry limit"
        default 5
        range 0 20
        depends on SMART_HELMET_WIFI_ENABLE

    config SMART_HELMET_CLOUD_ENABLE
        bool "Enable cloud reports and Firebase telemetry"
        default n

    config SMART_HELMET_CLOUD_FIREBASE
        bool "Use Firebase Realtime Database REST API"
        default n
        depends on SMART_HELMET_CLOUD_ENABLE
        help
            PATCH Devices/<device>/telemetry and Events/<device>/<stable ID>.
            Use a database secret, not a Firebase Web API key. Secret is stored
            locally in sdkconfig and compiled firmware. Do not publish either.

    config SMART_HELMET_CLOUD_TELEMETRY_INTERVAL_MS
        int "Firebase telemetry interval (ms)"
        default 5000
        range 1000 60000
        depends on SMART_HELMET_CLOUD_FIREBASE

    config SMART_HELMET_CLOUD_URL
        string "HTTP endpoint or Firebase HTTPS database root"
        default ""
        depends on SMART_HELMET_CLOUD_ENABLE

    config SMART_HELMET_CLOUD_AUTH_TOKEN
        string "Bearer token or Firebase legacy database secret"
        default ""
        depends on SMART_HELMET_CLOUD_ENABLE

    config SMART_HELMET_CLOUD_QUEUE_LENGTH
        int "Emergency report queue length"
        default 4
        range 1 16
        depends on SMART_HELMET_CLOUD_ENABLE

    config SMART_HELMET_CLOUD_TIMEOUT_MS
        int "Emergency HTTP request timeout in ms"
        default 5000
        range 1000 30000
        depends on SMART_HELMET_CLOUD_ENABLE

    config SMART_HELMET_BLE_ENABLE
        bool "Enable Helmet/Bike BLE communication contract"
        default n

endmenu
