menu "Smart Helmet Phase 7 Communication"

    config SMART_HELMET_WIFI_ENABLE
        bool "Enable Wi-Fi station manager"
        default n

    config SMART_HELMET_WIFI_SSID
        string "Wi-Fi SSID"
        default ""
        depends on SMART_HELMET_WIFI_ENABLE

    config SMART_HELMET_WIFI_PASSWORD
        string "Wi-Fi password"
        default ""
        depends on SMART_HELMET_WIFI_ENABLE

    config SMART_HELMET_WIFI_MAX_RETRY
        int "Wi-Fi reconnect retry limit"
        default 5
        range 0 20
        depends on SMART_HELMET_WIFI_ENABLE

    config SMART_HELMET_CLOUD_ENABLE
        bool "Enable emergency HTTP cloud client"
        default n

    config SMART_HELMET_CLOUD_URL
        string "Emergency HTTP/HTTPS endpoint URL"
        default ""
        depends on SMART_HELMET_CLOUD_ENABLE

    config SMART_HELMET_CLOUD_AUTH_TOKEN
        string "Emergency endpoint bearer token"
        default ""
        depends on SMART_HELMET_CLOUD_ENABLE

    config SMART_HELMET_CLOUD_QUEUE_LENGTH
        int "Emergency report queue length"
        default 4
        range 1 16
        depends on SMART_HELMET_CLOUD_ENABLE

    config SMART_HELMET_CLOUD_TIMEOUT_MS
        int "Emergency HTTP request timeout in ms"
        default 5000
        range 1000 30000
        depends on SMART_HELMET_CLOUD_ENABLE

    config SMART_HELMET_BLE_ENABLE
        bool "Enable Helmet/Bike BLE communication contract"
        default n

endmenu
